<?xml version="1.0"?>
<ruleset name="Member Documents">
	<description>WordPress Coding Standards for the Member Documents plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.4"/>

	<rule ref="WordPress-Extra"/>

	<!-- Classes follow PSR-4 file names (allowed by the project spec). -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/src/*</exclude-pattern>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="member-docs"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="member_docs"/>
				<element value="MemberDocs"/>
			</property>
		</properties>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- The plugin stores its data in custom tables, so direct queries are the point of the repositories. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>/src/Repository/*</exclude-pattern>
		<exclude-pattern>/src/Installer.php</exclude-pattern>
		<exclude-pattern>/uninstall.php</exclude-pattern>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- The legacy CSV parser is pure PHP; its messages are plain text for the CLI report, not HTML. -->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<exclude-pattern>/src/Cli/LegacyRowParser.php</exclude-pattern>
	</rule>

	<!-- Tests may use superglobals and file functions to set up scenarios. -->
	<rule ref="WordPress.Security.NonceVerification">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
